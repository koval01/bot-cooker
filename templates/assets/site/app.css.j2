{% set b = brand %}
{% set gap = [12, 14, 16, 18, 20, 24]|choice(persona_seed, "css-gap-" ~ name) %}
{% set lh = ["1.5", "1.55", "1.6", "1.65", "1.7"]|choice(persona_seed, "css-lh") %}
{% set root = ["--brand", "--color-primary", "--primary", "--c-primary", "--theme-primary"]|choice(persona_seed, "css-var") %}
:root{{ "{" }}{{ root }}:{{ b.primary }};{{ root }}-accent:{{ b.accent }};--text:{{ b.ink }};--bg:{{ b.paper }};--radius:{{ b.radius }}px{{ "}" }}*,:after,:before{box-sizing:border-box}html{-webkit-text-size-adjust:100%;line-height:{{ lh }}}body{margin:0;font-family:{{ b.font }};color:var(--text);background:var(--bg)}a{color:var({{ root }});text-decoration:{{ ["none", "underline"]|choice(persona_seed, "css-a") }}}a:hover{color:var({{ root }}-accent)}h1,h2,h3{line-height:1.2;margin:0 0 {{ gap }}px}h1{font-size:{{ ["2rem", "2.25rem", "2.5rem", "1.875rem"]|choice(persona_seed, "css-h1") }}}p{margin:0 0 {{ gap }}px}img{max-width:100%;height:auto}ul{padding-left:{{ gap + 4 }}px}{% for sel in ["header", "nav", "main", "footer"] %}{{ sel }},{% endfor %}.container{max-width:{{ b.width }}px;margin:0 auto;padding:0 {{ gap }}px}nav ul{list-style:none;display:flex;flex-wrap:wrap;gap:{{ gap }}px;padding:0;margin:0}footer{margin-top:{{ gap * 3 }}px;padding:{{ gap }}px 0;font-size:.875rem;opacity:.8}.btn,button,input[type=submit]{display:inline-block;padding:{{ gap // 2 }}px {{ gap }}px;border:0;border-radius:var(--radius);background:var({{ root }});color:#fff;cursor:pointer}.btn:hover,button:hover{background:var({{ root }}-accent)}input,select,textarea{font:inherit;padding:{{ gap // 2 }}px;border:1px solid {{ b.ink }}33;border-radius:var(--radius)}table{width:100%;border-collapse:collapse}td,th{padding:{{ gap // 2 }}px;border-bottom:1px solid {{ b.ink }}1a;text-align:left}.date{opacity:.7;font-size:.875em}@media (max-width:{{ [640, 720, 768]|choice(persona_seed, "css-bp") }}px){nav ul{flex-direction:column}h1{font-size:1.75rem}}
