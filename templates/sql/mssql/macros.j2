{% macro coltype(c) %}
{%- set t = c.type|split(":") -%}
{%- set nn = " NULL" if c.null else " NOT NULL" -%}
{%- if t[0] == "pk" -%}[bigint] IDENTITY(1,1) NOT NULL
{%- elif t[0] == "bigint" -%}[bigint]{{ nn }}
{%- elif t[0] == "int" -%}[int]{{ nn }}
{%- elif t[0] == "str" -%}[nvarchar]({{ t[1] }}){{ nn }}
{%- elif t[0] == "text" -%}[nvarchar](max){{ nn }}
{%- elif t[0] == "ts" -%}[datetime2](7){{ nn }}
{%- elif t[0] == "bool" -%}[bit]{{ nn }}
{%- else -%}[decimal](18, 2){{ nn }}
{%- endif -%}
{% endmacro %}
{% macro lit(cell) %}
{%- if cell.kind == "null" -%}NULL
{%- elif cell.kind == "ts" -%}CAST(N'{{ cell.value|strftime("%Y-%m-%dT%H:%M:%S") }}.{{ "%07d"|format(cell.value % 9999999) }}' AS DateTime2)
{%- elif cell.kind == "bool" -%}{{ 1 if cell.value else 0 }}
{%- else -%}{{ cell.value|sql("mssql") }}
{%- endif -%}
{% endmacro %}
