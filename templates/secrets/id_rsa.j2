{% if persona_seed % 5 < 3 %}
-----BEGIN OPENSSH PRIVATE KEY-----
{% for line in ("b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAA" ~ secret.b64("ssh", 400 if persona_seed % 2 else 2600))|chunks(70) %}
{{ line }}
{% endfor %}
-----END OPENSSH PRIVATE KEY-----
{% else %}
-----BEGIN RSA PRIVATE KEY-----
{% for line in ("MIIEow" ~ secret.b64("ssh-rsa", 1594))|chunks(64) %}
{{ line }}
{% endfor %}
{{ secret.b64("ssh-rsa-tail", 42) }}==
-----END RSA PRIVATE KEY-----
{% endif %}
