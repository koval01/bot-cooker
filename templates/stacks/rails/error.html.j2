<!DOCTYPE html>
<html>
<head>
  <title>{% if status == 404 %}The page you were looking for doesn't exist (404){% elif status == 422 %}The change you wanted was rejected (422){% else %}We're sorry, but something went wrong (500){% endif %}</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
  .rails-default-error-page {
    background-color: #EFEFEF;
    color: #2E2F30;
    text-align: center;
    font-family: arial, sans-serif;
    margin: 0;
  }

  .rails-default-error-page div.dialog {
    width: 95%;
    max-width: 33em;
    margin: 4em auto 0;
  }
  </style>
</head>

<body class="rails-default-error-page">
  <!-- This file lives in public/{{ status if status in [404, 422] else 500 }}.html -->
  <div class="dialog">
    <div>
{% if status == 404 %}
      <h1>The page you were looking for doesn't exist.</h1>
      <p>You may have mistyped the address or the page may have moved.</p>
{% elif status == 422 %}
      <h1>The change you wanted was rejected.</h1>
      <p>Maybe you tried to change something you didn't have access to.</p>
{% else %}
      <h1>We're sorry, but something went wrong.</h1>
{% endif %}
    </div>
    <p>If you are the application owner check the logs for more information.</p>
  </div>
</body>
</html>
