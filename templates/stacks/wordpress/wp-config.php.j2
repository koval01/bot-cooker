{% set q = style.php_double_quotes %}
{% set spaced = v.framework_major >= 5 or persona_seed % 2 == 0 %}
{% macro def(k, val) %}{% if spaced %}define( {{ k|php(q) }}, {{ val }} );{% else %}define({{ k|php(q) }}, {{ val }});{% endif %}{% endmacro %}
{% set verbose = persona_seed % 5 < 3 %}
<?php
{% if verbose %}
/**
 * The base configuration for WordPress
 *
 * The wp-config.php creation script uses this file during the installation.
 * You don't have to use the website, you can copy this file to "wp-config.php"
 * and fill in the values.
 *
 * This file contains the following configurations:
 *
 * * Database settings
 * * Secret keys
 * * Database table prefix
 * * ABSPATH
 *
 * @link https://developer.wordpress.org/advanced-administration/wordpress/wp-config/
 *
 * @package WordPress
 */

// ** Database settings - You can get this info from your web host ** //
/** The name of the database for WordPress */
{% endif %}
{{ def("DB_NAME", persona.db.name|php(q)) }}
{% if verbose %}

/** Database username */
{% endif %}
{{ def("DB_USER", persona.db.user|php(q)) }}
{% if verbose %}

/** Database password */
{% endif %}
{{ def("DB_PASSWORD", secret.get("db_password")|php(q)) }}
{% if verbose %}

/** Database hostname */
{% endif %}
{{ def("DB_HOST", persona.db.host|php(q)) }}
{% if verbose %}

/** Database charset to use in creating database tables. */
{% endif %}
{{ def("DB_CHARSET", ["utf8mb4", "utf8mb4", "utf8"]|choice(persona_seed, "wp-charset")|php(q)) }}
{% if verbose %}

/** The database collate type. Don't change this if in doubt. */
{% endif %}
{{ def("DB_COLLATE", ""|php(q)) }}

{% if verbose %}
/**#@+
 * Authentication unique keys and salts.
 *
 * Change these to different unique phrases! You can generate these using
 * the {@link https://api.wordpress.org/secret-key/1.1/salt/ WordPress.org secret-key service}.
 *
 * @since 2.6.0
 */
{% endif %}
{% for k in ["AUTH_KEY", "SECURE_AUTH_KEY", "LOGGED_IN_KEY", "NONCE_KEY", "AUTH_SALT", "SECURE_AUTH_SALT", "LOGGED_IN_SALT", "NONCE_SALT"] %}
{% set salt = secret.salt("wp_" ~ k, 64)|replace("'", "")|replace("\\", "") %}
{% if spaced %}define( '{{ k }}',{{ " " * (17 - k|length) }}'{{ salt }}' );{% else %}define('{{ k }}',{{ " " * (17 - k|length) }}'{{ salt }}');{% endif %}

{% endfor %}
{% if verbose %}

/**#@-*/

/**
 * WordPress database table prefix.
 *
 * You can have multiple installations in one database if you give each
 * a unique prefix. Only numbers, letters, and underscores please!
 */
{% endif %}
$table_prefix = '{{ persona.db.table_prefix }}';

{% if verbose %}
/**
 * For developers: WordPress debugging mode.
 *
 * Change this to true to enable the display of notices during development.
 */
{% endif %}
{% set debug = persona.php_errors.setting == "wp_debug" or (persona.php_errors.display == "off" and persona_seed % 7 == 0) %}
{{ def("WP_DEBUG", "true" if debug else "false") }}
{% if debug and persona.php_errors.display == "off" %}
{{ def("WP_DEBUG_DISPLAY", "false") }}
{% endif %}
{% if persona_seed % 5 == 1 %}
{{ def("WP_DEBUG_LOG", "true") }}
{% endif %}
{% if persona_seed % 3 == 0 %}
{{ def("DISALLOW_FILE_EDIT", "true") }}
{% endif %}
{% if persona_seed % 4 == 2 %}
{{ def("WP_MEMORY_LIMIT", ["256M", "512M"]|choice(persona_seed, "wp-mem")|php(q)) }}
{% endif %}
{% if note and persona_seed % 3 == 1 %}
// {{ note }}
{{ def("WP_HOME", ("https://" ~ persona.domain)|php(q)) }}
{{ def("WP_SITEURL", ("https://" ~ persona.domain)|php(q)) }}
{% endif %}

{% if verbose %}
/* Add any custom values between this line and the "stop editing" line. */



/* That's all, stop editing! Happy publishing. */

/** Absolute path to the WordPress directory. */
{% endif %}
if ( ! defined( 'ABSPATH' ) ) {
{{ style.indent }}define( 'ABSPATH', __DIR__ . '/' );
}

{% if verbose %}
/** Sets up WordPress vars and included files. */
{% endif %}
require_once ABSPATH . 'wp-settings.php';
