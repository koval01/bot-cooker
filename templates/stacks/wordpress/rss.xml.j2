<?xml version="1.0" encoding="UTF-8"?><rss version="2.0"
	xmlns:content="http://purl.org/rss/1.0/modules/content/"
	xmlns:wfw="http://wellformedweb.org/CommentAPI/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:atom="http://www.w3.org/2005/Atom"
	xmlns:sy="http://purl.org/rss/1.0/modules/syndication/"
	xmlns:slash="http://purl.org/rss/1.0/modules/slash/"
	>

<channel>
	<title>{{ persona.company }}</title>
	<atom:link href="{{ request.base_url }}/feed/" rel="self" type="application/rss+xml" />
	<link>{{ request.base_url }}</link>
	<description>{{ tagline }}</description>
	<lastBuildDate>{{ posts[0].time|strftime("%a, %d %b %Y %H:%M:%S +0000") }}</lastBuildDate>
	<language>en-US</language>
	<sy:updatePeriod>
	hourly	</sy:updatePeriod>
	<sy:updateFrequency>
	1	</sy:updateFrequency>
	<generator>https://wordpress.org/?v={{ v.framework }}</generator>
{% for post in posts %}
	<item>
		<title>{{ post.title }}</title>
		<link>{{ request.base_url }}{{ area }}{{ post.slug }}/</link>
		<dc:creator><![CDATA[{{ post.author_login }}]]></dc:creator>
		<pubDate>{{ post.time|strftime("%a, %d %b %Y %H:%M:%S +0000") }}</pubDate>
		<category><![CDATA[{{ post.category }}]]></category>
		<guid isPermaLink="false">{{ request.base_url }}/?p={{ post.n * 3 + 1 }}</guid>

					<description><![CDATA[{{ post.summary }} [&#8230;]]]></description>
	</item>
{% endfor %}
	</channel>
</rss>
