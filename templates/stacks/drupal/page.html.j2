<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
<meta name="Generator" content="Drupal {{ v.framework_major }} (https://www.drupal.org)" />
<meta name="MobileOptimized" content="width" />
<meta name="HandheldFriendly" content="true" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="alternate" type="application/rss+xml" title="" href="{{ request.base_url }}/rss.xml" />
    <title>{% if home %}{{ persona.company }}{% else %}{{ heading }} | {{ persona.company }}{% endif %}</title>
    <link rel="stylesheet" media="all" href="{{ assets.files.css.href }}" />
  </head>
  <body class="{{ "path-frontpage" if home else "path-node page-node-type-article" }}">
    <a href="#main-content" class="visually-hidden focusable skip-link">Skip to main content</a>
    <div class="dialog-off-canvas-main-canvas" data-off-canvas-main-canvas>
      <header class="site-header">
        <div class="site-branding__text"><div class="site-branding__name"><a href="/" title="Home" rel="home">{{ persona.company }}</a></div></div>
        <nav role="navigation" aria-label="Main navigation"><ul class="primary-nav__menu">
{% for item in nav %}
          <li class="primary-nav__menu-item"><a href="{{ item.href }}" class="primary-nav__menu-link">{{ item.label }}</a></li>
{% endfor %}
        </ul></nav>
      </header>
      <main role="main">
        <a id="main-content" tabindex="-1"></a>
        <h1 class="page-title"><span class="field field--name-title">{{ heading }}</span></h1>
        <div class="text-content clearfix field field--name-body field--type-text-with-summary field--label-hidden field__item">
{% for p in paragraphs %}
<p>{{ p }}</p>
{% endfor %}
        </div>
        <div class="views-element-container"><div class="view view-frontpage">
{% for link in links %}
          <article class="node node--type-article node--view-mode-teaser"><h2 class="node__title"><a href="{{ link.href }}" rel="bookmark"><span class="field field--name-title">{{ link.title }}</span></a></h2></article>
{% endfor %}
        </div></div>
      </main>
      <footer class="site-footer">&copy; {{ epochs.cfg_anchor|strftime("%Y") }} {{ persona.company }}.{{ [" All rights reserved.", "", " All rights reserved", " Made with care."]|choice(persona_seed, "footer") }}</footer>
    </div>
  </body>
</html>
